/* ============================================================
   TFT - MOSTRAR TEMPERATURA
   ============================================================ */

static void TFT_MostrarValor(
    const char *valor,
    int32_t temp)
{
    uint16_t color;
    const char *mensajeEstado;

    if (temp < UMBRAL_FRIO)
    {
        color = CELESTE;
        mensajeEstado = "ESTADO FRIO";
    }
    else if (temp < UMBRAL_CALIENTE)
    {
        color = VERDE;
        mensajeEstado = "ESTADO NORMAL";
    }
    else
    {
        color = ROJO;
        mensajeEstado = "ESTADO CALIENTE";
    }

    TFT_Rectangulo(
        22, 82, 276, 77, PANEL
    );

    TFT_Termometro(color);

    uint16_t cantidad =
        (uint16_t)strlen(valor);

    uint8_t escala =
        cantidad <= 6U ? 4U : 3U;

    uint16_t x = 63U;

    TFT_Texto(
        x,
        101,
        valor,
        escala,
        BLANCO,
        PANEL
    );

    uint16_t unidadX =
        x + cantidad * 6U * escala + 5U;

    TFT_Grado(
        unidadX,
        105,
        CELESTE
    );

    TFT_Texto(
        unidadX + 15U,
        101,
        "C",
        3,
        CELESTE,
        PANEL
    );

    TFT_Rectangulo(
        27, 163, 264, 9, BARRA
    );

    int32_t limitada = temp;

    if (limitada < 0)
    {
        limitada = 0;
    }

    if (limitada > 5000)
    {
        limitada = 5000;
    }

    uint16_t largo =
        (uint16_t)((limitada * 264) / 5000);

    if (largo > 0U)
    {
        TFT_Rectangulo(
            27,
            163,
            largo,
            9,
            color
        );
    }

    TFT_MostrarEstado(
        mensajeEstado,
        color
    );
}

