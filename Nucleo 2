static void UART_Texto(
    UART_HandleTypeDef *uart,
    const char *mensaje)
{
    if (uart == NULL || mensaje == NULL)
    {
        return;
    }

    HAL_UART_Transmit(
        uart,
        (uint8_t *)mensaje,
        (uint16_t)strlen(mensaje),
        1000
    );
}

static void UART_Responder(const char *mensaje)
{
    UART_Texto(&huart2, mensaje);
    UART_Texto(&huart1, mensaje);
}

