/* ============================================================
   FUNCION PRINCIPAL DE GUARDADO MICROSD
   ============================================================ */

static void SD_GuardarTemperatura(void)
{
    FRESULT resultado = FR_OK;

    FRESULT resultadoCierre = FR_OK;
    FRESULT resultadoDesmontar = FR_OK;

    UINT escritos = 0U;
    UINT leidos = 0U;

    char valor[20];
    char registro[80];

    uint8_t bufferLectura[128];

    uint32_t numeroMedicion = 1U;
    uint32_t lineasEncontradas = 0U;

    uint32_t tamanoInicial = 0U;

    int longitudRegistro;

    const char *etapaError = "NINGUNA";

    uint8_t archivoAbierto = 0U;
    uint8_t sistemaMontado = 0U;

    numeroIntentosSD++;

    DEBUG_Print(
        "\r\n========================================\r\n"
        "[SD DEBUG] INICIO DE GUARDADO\r\n"
        "[SD DEBUG] Intento: %lu\r\n"
        "========================================\r\n",
        (unsigned long)numeroIntentosSD
    );

    /* --------------------------------------------------------
       PASO 1: VALIDACIONES
       -------------------------------------------------------- */

    if (sdOperacionActiva)
    {
        DEBUG_Print(
            "[SD DEBUG] Operacion SD ocupada\r\n"
        );

        UART_Responder("SD_ERROR\r\n");
        return;
    }

    if (!medicionValida)
    {
        DEBUG_Print(
            "[SD DEBUG] No hay medicion valida\r\n"
        );

        UART_Responder("SD_SIN_DATOS\r\n");
        return;
    }

    sdOperacionActiva = 1U;

    FormatearTemperatura(
        valor,
        sizeof(valor),
        ultimaTemperaturaValida
    );

    DEBUG_Print(
        "[SD DEBUG] Temperatura: %s C\r\n",
        valor
    );

    /* --------------------------------------------------------
       PASO 2: COMPROBAR FATFS
       -------------------------------------------------------- */

    if (retUSER != 0U)
    {
        etapaError = "FATFS_LinkDriver";
        goto error_sd;
    }

    /* --------------------------------------------------------
       PASO 3: MONTAR MICROSD
       -------------------------------------------------------- */

    resultado = f_mount(
        &sdFatFs,
        "0:",
        1
    );

    SD_MostrarResultado("f_mount", resultado);

    if (resultado != FR_OK)
    {
        etapaError = "f_mount";
        goto error_sd;
    }

    sistemaMontado = 1U;

    /* --------------------------------------------------------
       PASO 4: ABRIR O CREAR CSV
       -------------------------------------------------------- */

    resultado = f_open(
        &sdArchivo,
        ARCHIVO_SD,
        FA_OPEN_ALWAYS | FA_READ | FA_WRITE
    );

    SD_MostrarResultado("f_open", resultado);

    if (resultado != FR_OK)
    {
        etapaError = "f_open";
        goto error_sd;
    }

    archivoAbierto = 1U;

    tamanoInicial =
        (uint32_t)f_size(&sdArchivo);

    /* --------------------------------------------------------
       PASO 5: CONTAR MEDICIONES ANTERIORES
       -------------------------------------------------------- */

    if (tamanoInicial > 0U)
    {
        resultado = f_lseek(
            &sdArchivo,
            0U
        );

        SD_MostrarResultado(
            "f_lseek inicio",
            resultado
        );

        if (resultado != FR_OK)
        {
            etapaError = "f_lseek inicio";
            goto error_sd;
        }

        do
        {
            leidos = 0U;

            resultado = f_read(
                &sdArchivo,
                bufferLectura,
                sizeof(bufferLectura),
                &leidos
            );

            if (resultado != FR_OK)
            {
                etapaError = "f_read contador";
                goto error_sd;
            }

            for (UINT i = 0U; i < leidos; i++)
            {
                if (bufferLectura[i] == '\n')
                {
                    lineasEncontradas++;
                }
            }

        } while (leidos > 0U);

        if (lineasEncontradas > 0U)
        {
            numeroMedicion = lineasEncontradas;
        }
    }

    /* --------------------------------------------------------
       PASO 6: IR AL FINAL DEL ARCHIVO
       -------------------------------------------------------- */

    resultado = f_lseek(
        &sdArchivo,
        f_size(&sdArchivo)
    );

    SD_MostrarResultado(
        "f_lseek final",
        resultado
    );

    if (resultado != FR_OK)
    {
        etapaError = "f_lseek final";
        goto error_sd;
    }

    /* --------------------------------------------------------
       PASO 7: ESCRIBIR ENCABEZADO SI ES NUEVO
       -------------------------------------------------------- */

    if (tamanoInicial == 0U)
    {
        const char encabezado[] =
            "Medicion,Temperatura\r\n";

        UINT cantidadEsperada =
            (UINT)(sizeof(encabezado) - 1U);

        escritos = 0U;

        resultado = f_write(
            &sdArchivo,
            encabezado,
            cantidadEsperada,
            &escritos
        );

        SD_MostrarResultado(
            "f_write encabezado",
            resultado
        );

        if (resultado != FR_OK ||
            escritos != cantidadEsperada)
        {
            etapaError = "f_write encabezado";
            goto error_sd;
        }

        DEBUG_Print(
            "[SD DEBUG] Encabezado creado\r\n"
        );
    }

    /* --------------------------------------------------------
       PASO 8: PREPARAR MEDICION Y TEMPERATURA
       -------------------------------------------------------- */

    longitudRegistro = snprintf(
        registro,
        sizeof(registro),
        "Medicion %lu,%s C\r\n",
        (unsigned long)numeroMedicion,
        valor
    );

    if (longitudRegistro <= 0 ||
        longitudRegistro >= (int)sizeof(registro))
    {
        etapaError = "snprintf registro";
        goto error_sd;
    }

    /* --------------------------------------------------------
       PASO 9: ESCRIBIR REGISTRO
       -------------------------------------------------------- */

    escritos = 0U;

    resultado = f_write(
        &sdArchivo,
        registro,
        (UINT)longitudRegistro,
        &escritos
    );

    SD_MostrarResultado(
        "f_write temperatura",
        resultado
    );

    if (resultado != FR_OK ||
        escritos != (UINT)longitudRegistro)
    {
        etapaError = "f_write temperatura";
        goto error_sd;
    }

    /* --------------------------------------------------------
       PASO 10: SINCRONIZAR
       -------------------------------------------------------- */

    resultado = f_sync(&sdArchivo);

    SD_MostrarResultado(
        "f_sync",
        resultado
    );

    if (resultado != FR_OK)
    {
        etapaError = "f_sync";
        goto error_sd;
    }

    /* --------------------------------------------------------
       PASO 11: CERRAR ARCHIVO
       -------------------------------------------------------- */

    resultadoCierre = f_close(&sdArchivo);

    SD_MostrarResultado(
        "f_close",
        resultadoCierre
    );

    archivoAbierto = 0U;

    if (resultadoCierre != FR_OK)
    {
        resultado = resultadoCierre;
        etapaError = "f_close";
        goto error_sd;
    }

    /* --------------------------------------------------------
       PASO 12: DESMONTAR MICROSD
       -------------------------------------------------------- */

    resultadoDesmontar = f_mount(
        NULL,
        "0:",
        0
    );

    SD_MostrarResultado(
        "f_mount desmontar",
        resultadoDesmontar
    );

    sistemaMontado = 0U;

    if (resultadoDesmontar != FR_OK)
    {
        resultado = resultadoDesmontar;
        etapaError = "f_mount desmontar";
        goto error_sd;
    }

    /* --------------------------------------------------------
       GUARDADO EXITOSO
       -------------------------------------------------------- */

    sdOperacionActiva = 0U;

    DEBUG_Print(
        "\r\n========================================\r\n"
        "[SD DEBUG] GUARDADO COMPLETADO\r\n"
        "[SD DEBUG] Medicion %lu: %s C\r\n"
        "[SD DEBUG] Archivo MEDICION.CSV actualizado\r\n"
        "========================================\r\n\r\n",
        (unsigned long)numeroMedicion,
        valor
    );

    UART_Responder("SD_OK\r\n");

    return;

    /* --------------------------------------------------------
       MANEJO DE ERRORES
       -------------------------------------------------------- */

error_sd:

    DEBUG_Print(
        "\r\n!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\r\n"
        "[SD DEBUG] ERROR DETECTADO\r\n"
        "[SD DEBUG] Etapa fallida: %s\r\n"
        "[SD DEBUG] Codigo FatFs: %d\r\n"
        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\r\n",
        etapaError,
        (int)resultado
    );

    if (archivoAbierto)
    {
        FRESULT cierre = f_close(&sdArchivo);

        SD_MostrarResultado(
            "f_close limpieza",
            cierre
        );
    }

    if (sistemaMontado)
    {
        FRESULT desmontar = f_mount(
            NULL,
            "0:",
            0
        );

        SD_MostrarResultado(
            "f_mount limpieza",
            desmontar
        );
    }

    sdOperacionActiva = 0U;

    UART_Responder("SD_ERROR\r\n");
}

/* ============================================================
   TFT - ENVIO SPI3
   ============================================================ */

static void SPI_Enviar(
    const uint8_t *datos,
    uint16_t cantidad)
{
    if (HAL_SPI_Transmit(
            &hspi3,
            (uint8_t *)datos,
            cantidad,
            1000
        ) != HAL_OK)
    {
        Error_Handler();
    }
}

static void TFT_Comando(
    uint8_t cmd,
    const uint8_t *datos,
    uint16_t cantidad)
{
    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_RESET
    );

    HAL_GPIO_WritePin(
        TFT_DC_GPIO_Port,
        TFT_DC_Pin,
        GPIO_PIN_RESET
    );

    SPI_Enviar(&cmd, 1U);

    if (cantidad > 0U)
    {
        HAL_GPIO_WritePin(
            TFT_DC_GPIO_Port,
            TFT_DC_Pin,
            GPIO_PIN_SET
        );

        SPI_Enviar(
            datos,
            cantidad
        );
    }

    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_SET
    );
}

/* ============================================================
   TFT - VENTANA
   ============================================================ */

static void TFT_Ventana(
    uint16_t x,
    uint16_t y,
    uint16_t w,
    uint16_t h)
{
    uint16_t fx = x + w - 1U;
    uint16_t fy = y + h - 1U;

    uint8_t columnas[] =
    {
        (uint8_t)(x >> 8),
        (uint8_t)(x & 255U),
        (uint8_t)(fx >> 8),
        (uint8_t)(fx & 255U)
    };

    uint8_t filas[] =
    {
        (uint8_t)(y >> 8),
        (uint8_t)(y & 255U),
        (uint8_t)(fy >> 8),
        (uint8_t)(fy & 255U)
    };

    uint8_t cmd = 0x2CU;

    TFT_Comando(
        0x2AU,
        columnas,
        sizeof(columnas)
    );

    TFT_Comando(
        0x2BU,
        filas,
        sizeof(filas)
    );

    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_RESET
    );

    HAL_GPIO_WritePin(
        TFT_DC_GPIO_Port,
        TFT_DC_Pin,
        GPIO_PIN_RESET
    );

    SPI_Enviar(&cmd, 1U);

    HAL_GPIO_WritePin(
        TFT_DC_GPIO_Port,
        TFT_DC_Pin,
        GPIO_PIN_SET
    );
}

/* ============================================================
   TFT - RECTANGULO
   ============================================================ */

static void TFT_Rectangulo(
    uint16_t x,
    uint16_t y,
    uint16_t w,
    uint16_t h,
    uint16_t color)
{
    if (x >= TFT_ANCHO ||
        y >= TFT_ALTO ||
        w == 0U ||
        h == 0U)
    {
        return;
    }

    if (w > TFT_ANCHO - x)
    {
        w = TFT_ANCHO - x;
    }

    if (h > TFT_ALTO - y)
    {
        h = TFT_ALTO - y;
    }

    for (uint16_t i = 0U; i < 256U; i++)
    {
        pixeles[2U * i] =
            (uint8_t)(color >> 8);

        pixeles[2U * i + 1U] =
            (uint8_t)(color & 255U);
    }

    TFT_Ventana(x, y, w, h);

    uint32_t restantes =
        (uint32_t)w * h;

    while (restantes > 0U)
    {
        uint16_t cantidad =
            restantes > 256U
            ? 256U
            : (uint16_t)restantes;

        SPI_Enviar(
            pixeles,
            (uint16_t)(cantidad * 2U)
        );

        restantes -= cantidad;
    }

    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_SET
    );
}

/* ============================================================
   TFT - FUENTE
   ============================================================ */

static uint8_t Fuente_Columna(
    char c,
    uint8_t columna)
{
    if (c >= '0' && c <= '9')
    {
        return fuente[c - '0'][columna];
    }

    if (c >= 'A' && c <= 'Z')
    {
        return fuente[10 + c - 'A'][columna];
    }

    if (c == '-')
    {
        return 0x08U;
    }

    if (c == '.')
    {
        return columna == 2U ? 0x60U : 0U;
    }

    if (c == ':')
    {
        return columna == 2U ? 0x36U : 0U;
    }

    if (c == '%')
    {
        return columna == 2U ? 0x14U : 0x62U;
    }

    return 0U;
}

/* ============================================================
   TFT - CARACTER
   ============================================================ */

static void TFT_Caracter(
    uint16_t x,
    uint16_t y,
    char c,
    uint8_t escala,
    uint16_t frente,
    uint16_t fondo)
{
    if (escala < 1U ||
        escala > 4U ||
        x + 6U * escala > TFT_ANCHO ||
        y + 8U * escala > TFT_ALTO)
    {
        return;
    }

    uint16_t indice = 0U;

    for (uint16_t fila = 0U;
         fila < 8U * escala;
         fila++)
    {
        for (uint16_t columna = 0U;
             columna < 6U * escala;
             columna++)
        {
            uint8_t encendido = 0U;

            if (columna / escala < 5U)
            {
                encendido =
                    (Fuente_Columna(
                        c,
                        (uint8_t)(columna / escala)
                    ) >> (fila / escala)) & 1U;
            }

            uint16_t color =
                encendido ? frente : fondo;

            pixeles[indice++] =
                (uint8_t)(color >> 8);

            pixeles[indice++] =
                (uint8_t)(color & 255U);
        }
    }

    TFT_Ventana(
        x,
        y,
        6U * escala,
        8U * escala
    );

    SPI_Enviar(
        pixeles,
        indice
    );

    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_SET
    );
}

/* ============================================================
   TFT - TEXTO
   ============================================================ */

static void TFT_Texto(
    uint16_t x,
    uint16_t y,
    const char *cadena,
    uint8_t escala,
    uint16_t frente,
    uint16_t fondo)
{
    while (*cadena &&
           x + 6U * escala <= TFT_ANCHO)
    {
        TFT_Caracter(
            x,
            y,
            *cadena++,
            escala,
            frente,
            fondo
        );

        x += 6U * escala;
    }
}

