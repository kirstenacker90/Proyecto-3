   ============================================================ */

static void TFT_Iniciar(void)
{
    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_SET
    );

    HAL_GPIO_WritePin(
        TFT_RST_GPIO_Port,
        TFT_RST_Pin,
        GPIO_PIN_SET
    );

    HAL_Delay(20);

    HAL_GPIO_WritePin(
        TFT_RST_GPIO_Port,
        TFT_RST_Pin,
        GPIO_PIN_RESET
    );

    HAL_Delay(20);

    HAL_GPIO_WritePin(
        TFT_RST_GPIO_Port,
        TFT_RST_Pin,
        GPIO_PIN_SET
    );

    HAL_Delay(150);

    TFT_Comando(0x01, NULL, 0);

    HAL_Delay(150);

    typedef struct
    {
        uint8_t cmd;
        uint8_t cantidad;
        uint8_t datos[15];

    } ComandoTFT;

    static const ComandoTFT configuracion[] =
    {
        {0xEF,3,{0x03,0x80,0x02}},
        {0xCF,3,{0x00,0xC1,0x30}},
        {0xED,4,{0x64,0x03,0x12,0x81}},
        {0xE8,3,{0x85,0x00,0x78}},
        {0xCB,5,{0x39,0x2C,0x00,0x34,0x02}},
        {0xF7,1,{0x20}},
        {0xEA,2,{0x00,0x00}},
        {0xC0,1,{0x23}},
        {0xC1,1,{0x10}},
        {0xC5,2,{0x3E,0x28}},
        {0xC7,1,{0x86}},
        {0x36,1,{0x28}},
        {0x3A,1,{0x55}},
        {0xB1,2,{0x00,0x18}},
        {0xB6,3,{0x08,0x82,0x27}},
        {0xF2,1,{0x00}},
        {0x26,1,{0x01}},

        {0xE0,15,{
            0x0F,0x31,0x2B,0x0C,0x0E,
            0x08,0x4E,0xF1,0x37,0x07,
            0x10,0x03,0x0E,0x09,0x00
        }},

        {0xE1,15,{
            0x00,0x0E,0x14,0x03,0x11,
            0x07,0x31,0xC1,0x48,0x08,
            0x0F,0x0C,0x31,0x36,0x0F
        }}
    };

    for (uint32_t i = 0U;
         i < sizeof(configuracion) /
             sizeof(configuracion[0]);
         i++)
    {
        TFT_Comando(
            configuracion[i].cmd,
            configuracion[i].datos,
            configuracion[i].cantidad
        );
    }

    TFT_Comando(0x11, NULL, 0);
    HAL_Delay(150);

    TFT_Comando(0x29, NULL, 0);
    HAL_Delay(50);

    TFT_Estructura();
    TFT_MostrarEspera();
}

/* ============================================================
   MAIN
   ============================================================ */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_SPI2_Init();
    MX_SPI3_Init();
    MX_USART1_UART_Init();
    MX_USART2_UART_Init();

    /* --------------------------------------------------------
       FATFS
       -------------------------------------------------------- */

    MX_FATFS_Init();

    /* --------------------------------------------------------
       TFT
       -------------------------------------------------------- */

    TFT_Iniciar();

    /* --------------------------------------------------------
       UART1
       -------------------------------------------------------- */

    if (HAL_UART_Receive_IT(
            &huart1,
            &datoUART,
            1
        ) != HAL_OK)
    {
        Error_Handler();
    }

    /* --------------------------------------------------------
       UNICO MENSAJE DE INICIO
       -------------------------------------------------------- */

    UART_Texto(
        &huart2,
        "Esperando comandos...\r\n\r\n"
    );

    /* --------------------------------------------------------
       CICLO PRINCIPAL
       -------------------------------------------------------- */

    while (1)
    {
        ProcesarUART();

        /* ----------------------------------------------------
           GUARDAR
           ---------------------------------------------------- */

        if (solicitudGuardado)
        {
            solicitudGuardado = 0U;

            SD_GuardarTemperatura();
        }

        /* ----------------------------------------------------
           MAQUINA DE ESTADOS
           ---------------------------------------------------- */

        switch (estado)
        {
            case REPOSO:

                if (solicitudLectura)
                {
                    solicitudLectura = 0U;

                    t0 = HAL_GetTick();

                    DEBUG_Print(
                        "[LM75 DEBUG] Iniciando medicion...\r\n"
                    );

                    estado = MIDIENDO;
                }

                break;

            case MIDIENDO:

                if ((HAL_GetTick() - t0) >=
                    ESPERA_MEDICION)
                {
                    HAL_StatusTypeDef resultado =
                        HAL_ERROR;

                    if (!sensorPreparado)
                    {
                        sensorPreparado =
                            (Sensor_Iniciar() == HAL_OK);
                    }

                    if (sensorPreparado)
                    {
                        resultado =
                            Sensor_Temperatura(
                                &temperatura
                            );
                    }

                    if (resultado == HAL_OK)
                    {
                        char valor[20];
                        char mensaje[64];

                        ultimaTemperaturaValida =
                            temperatura;

                        medicionValida = 1U;

                        FormatearTemperatura(
                            valor,
                            sizeof(valor),
                            temperatura
                        );

                        DEBUG_Print(
                            "[LM75 DEBUG] Temperatura valida: %s C\r\n",
                            valor
                        );

                        snprintf(
                            mensaje,
                            sizeof(mensaje),
                            "Temperatura: %s C\r\n",
                            valor
                        );

                        UART_Responder(mensaje);

                        TFT_MostrarValor(
                            valor,
                            temperatura
                        );

                        t0 = HAL_GetTick();

                        if (temperatura >= UMBRAL_CALIENTE)
                        {
                            estado = ALERTA;
                        }
                        else
                        {
                            estado = ESTADO_OK;
                        }
                    }
                    else
                    {
                        sensorPreparado = 0U;

                        DEBUG_Print(
                            "[LM75 DEBUG] Error: %s\r\n",
                            motivoError
                        );

                        UART_Responder(
                            "ERROR_SENSOR\r\n"
                        );

                        TFT_MostrarError();

                        t0 = HAL_GetTick();

                        estado = ERROR_I2C;
                    }
                }

                break;

            case ESTADO_OK:

                if ((HAL_GetTick() - t0) >=
                    DURACION_RESULTADO)
                {
                    if (temperatura < UMBRAL_FRIO)
                    {
                        DEBUG_Print(
                            "[LM75 DEBUG] ESTADO FRIO\r\n"
                        );
                    }
                    else
                    {
                        DEBUG_Print(
                            "[LM75 DEBUG] ESTADO NORMAL\r\n"
                        );
                    }

                    estado = REPOSO;
                }

                break;

            case ALERTA:

                if ((HAL_GetTick() - t0) >=
                    DURACION_RESULTADO)
                {
                    DEBUG_Print(
                        "[LM75 DEBUG] ESTADO CALIENTE\r\n"
                    );

                    estado = REPOSO;
                }

                break;

            case ERROR_I2C:

                if ((HAL_GetTick() - t0) >=
                    DURACION_RESULTADO)
                {
                    estado = REPOSO;
                }

                break;

            default:

                estado = REPOSO;
                break;
        }
    }
}

