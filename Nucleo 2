/* ============================================================
   FORMATEAR TEMPERATURA
   ============================================================ */

static void FormatearTemperatura(
    char *destino,
    size_t tam,
    int32_t valor)
{
    int32_t absoluto =
        valor < 0 ? -valor : valor;

    snprintf(
        destino,
        tam,
        "%s%ld.%02ld",
        valor < 0 ? "-" : "",
        (long)(absoluto / 100),
        (long)(absoluto % 100)
    );
}

/* ============================================================
   SENSOR LM75B
   ============================================================ */

static HAL_StatusTypeDef Sensor_Iniciar(void)
{
    for (uint8_t dir = 0x48U; dir <= 0x4FU; dir++)
    {
        uint16_t direccion =
            (uint16_t)dir << 1;

        if (HAL_I2C_IsDeviceReady(
                &hi2c1,
                direccion,
                3,
                100
            ) == HAL_OK)
        {
            direccionSensor = direccion;

            motivoError = "Sin diagnostico";

            DEBUG_Print(
                "[LM75 DEBUG] Sensor encontrado en 0x%02X\r\n",
                dir
            );

            return HAL_OK;
        }
    }

    motivoError = "LM75 no responde";

    return HAL_ERROR;
}

static HAL_StatusTypeDef Sensor_Temperatura(
    int32_t *resultado)
{
    uint8_t datos[2];

    if (resultado == NULL)
    {
        return HAL_ERROR;
    }

    if (HAL_I2C_Mem_Read(
            &hi2c1,
            direccionSensor,
            0x00,
            I2C_MEMADD_SIZE_8BIT,
            datos,
            2,
            100
        ) != HAL_OK)
    {
        motivoError =
            "No se pudo leer temperatura LM75";

        return HAL_ERROR;
    }

    uint16_t crudo =
        ((uint16_t)datos[0] << 8) |
        (uint16_t)datos[1];

    int16_t onceBits =
        (int16_t)(crudo >> 5);

    if (onceBits & 0x0400)
    {
        onceBits =
            (int16_t)(onceBits | 0xF800);
    }

    *resultado =
        ((int32_t)onceBits * 100) / 8;

    return HAL_OK;
}

/* ============================================================
   PROCESAR COMANDOS UART
   ============================================================ */

static void ProcesarUART(void)
{
    if (errorUART)
    {
        errorUART = 0U;
        longitudComando = 0U;
        descartarComando = 1U;
    }

    while (lecturaUART != escrituraUART)
    {
        uint8_t dato =
            colaUART[lecturaUART];

        lecturaUART =
            (lecturaUART + 1U) % TAM_COLA;

        if (dato == '\r' || dato == '\n')
        {
            if (descartarComando)
            {
                descartarComando = 0U;
                longitudComando = 0U;
                continue;
            }

            if (longitudComando > 0U)
            {
                comando[longitudComando] = '\0';

                DEBUG_Print(
                    "[UART DEBUG] Comando recibido: %s\r\n",
                    comando
                );

                if (!strcmp(comando, "LECTURA") ||
                    !strcmp(comando, "LEER") ||
                    !strcmp(comando, "L"))
                {
                    solicitudLectura = 1U;
                }
                else if (!strcmp(comando, "GUARDADO") ||
                         !strcmp(comando, "GUARDAR") ||
                         !strcmp(comando, "G"))
                {
                    solicitudGuardado = 1U;
                }
                else
                {
                    UART_Responder(
                        "COMANDO_INVALIDO\r\n"
                    );
                }

                longitudComando = 0U;
            }

            continue;
        }

        if (descartarComando)
        {
            continue;
        }

        if (dato >= 'a' && dato <= 'z')
        {
            dato =
                (uint8_t)(dato - ('a' - 'A'));
        }

        if (dato >= 32U && dato <= 126U)
        {
            if (longitudComando < TAM_COMANDO - 1U)
            {
                comando[longitudComando++] =
                    (char)dato;
            }
            else
            {
                longitudComando = 0U;
                descartarComando = 1U;
            }
        }
    }
}

