    TIM_HandleTypeDef *htim)
{
    if ((htim->Instance == TIM1) &&
        (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1))
    {
        __HAL_TIM_DISABLE_DMA(
            htim,
            TIM_DMA_CC1
        );

        __HAL_TIM_SET_COMPARE(
            htim,
            TIM_CHANNEL_1,
            0
        );

        neoTerminado = 1;
    }
}

