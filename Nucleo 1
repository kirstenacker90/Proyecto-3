/* ============================================================
   GENERAR TONO CON DAC
   ============================================================ */

static void Audio_Nota(
    uint16_t frecuencia,
    uint16_t duracion)
{
    if (frecuencia == 0U)
    {
        HAL_DAC_SetValue(
            &hdac,
            DAC_CHANNEL_1,
            DAC_ALIGN_12B_R,
            0
        );

        HAL_Delay(duracion);
        return;
    }

    uint32_t medioPeriodo =
        500000U / frecuencia;

    uint32_t repeticiones =
        ((uint32_t)frecuencia * duracion) / 1000U;

    for (uint32_t i = 0; i < repeticiones; i++)
    {
        HAL_DAC_SetValue(
            &hdac,
            DAC_CHANNEL_1,
            DAC_ALIGN_12B_R,
            4095
        );

        Audio_Esperar_us(medioPeriodo);

        HAL_DAC_SetValue(
            &hdac,
            DAC_CHANNEL_1,
            DAC_ALIGN_12B_R,
            0
        );

        Audio_Esperar_us(medioPeriodo);
    }

    HAL_DAC_SetValue(
        &hdac,
        DAC_CHANNEL_1,
        DAC_ALIGN_12B_R,
        0
    );

    HAL_Delay(15);
}

