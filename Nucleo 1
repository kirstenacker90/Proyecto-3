/* ============================================================
   CALLBACK DE RECEPCION UART
   ============================================================ */

void HAL_UART_RxCpltCallback(
    UART_HandleTypeDef *huart)
{
    /* ========================================================
       RECEPCION ESP32 - USART1
       ======================================================== */

    if (huart->Instance == USART1)
    {
        uint16_t siguiente =
            (escritura + 1U) % TAM_COLA;

        if (siguiente != lectura)
        {
            cola[escritura] = datoUART;

            escritura = siguiente;
        }
        else
        {
            errorRecepcion = 1;
        }

        HAL_UART_Receive_IT(
            &huart1,
            &datoUART,
            1
        );
    }

    /* ========================================================
       RECEPCION NUCLEO 2 - USART3
       ======================================================== */

    else if (huart->Instance == USART3)
    {
        uint16_t siguiente =
            (escrituraN2 + 1U) % TAM_COLA_N2;

        if (siguiente != lecturaN2)
        {
            colaN2[escrituraN2] = datoUART3;

            escrituraN2 = siguiente;
        }
        else
        {
            errorUART3 = 1;
        }

        HAL_UART_Receive_IT(
            &huart3,
            &datoUART3,
            1
        );
    }
}

/* ============================================================
   CALLBACK DE ERRORES UART
   ============================================================ */

void HAL_UART_ErrorCallback(
    UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        errorRecepcion = 1;

        HAL_UART_Receive_IT(
            &huart1,
            &datoUART,
            1
        );
    }

    else if (huart->Instance == USART3)
    {
        errorUART3 = 1;

        HAL_UART_Receive_IT(
            &huart3,
            &datoUART3,
            1
        );
    }
}

