        LD2_Pin,
        GPIO_PIN_SET
    );

    HAL_Delay(500);

    /* ========================================================
       SONIDOS DE INICIO
       ======================================================== */

#if PRUEBA_SONIDOS_INICIO

    Sonido_Prueba();

    HAL_Delay(400);

    Sonido_Bienvenida();

    HAL_Delay(300);

    Sonido_Enviando();

    HAL_Delay(300);

    Sonido_Error();

    HAL_Delay(300);

    Sonido_Exito();

#else

    Sonido_Bienvenida();

#endif

    /* ========================================================
       CONFIGURAR NEOPIXEL
       ======================================================== */

    NeoPixel_ConfigurarGPIO();

    /* ========================================================
       HABILITAR RECEPCION DESDE ESP32
       ======================================================== */

    if (HAL_UART_Receive_IT(
            &huart1,
            &datoUART,
            1) != HAL_OK)
    {
        Error_Handler();
    }

    /* ========================================================
       HABILITAR RECEPCION DESDE NUCLEO 2
       ======================================================== */

    if (HAL_UART_Receive_IT(
            &huart3,
            &datoUART3,
            1) != HAL_OK)
    {
        Error_Handler();
    }

    HAL_Delay(2);

    /* ========================================================
       NEOPIXEL AZUL - ESPERA
       ======================================================== */

    if (NeoPixel_Color(
            0,
            0,
            NEO_BRILLO) != HAL_OK)
    {
        Error_Handler();
    }

    /* ========================================================
       MENSAJES DE INICIO
       ======================================================== */

    UART_Texto(
        &huart2,
        "\r\n================================\r\n"
    );

    UART_Texto(
        &huart2,
        "PROYECTO 03 - NUCLEO 1\r\n"
    );

    UART_Texto(
        &huart2,
        "================================\r\n"
    );

    UART_Texto(
        &huart2,
        "USART1: ESP32\r\n"
    );

    UART_Texto(
        &huart2,
        "USART2: Hercules\r\n"
    );

    UART_Texto(
        &huart2,
        "USART3: Nucleo 2\r\n"
    );

    UART_Texto(
        &huart2,
        "Comandos: LECTURA / GUARDADO\r\n"
    );

    UART_Texto(
        &huart2,
        "Esperando comandos...\r\n"
    );

    /* USER CODE END 2 */

    /* USER CODE BEGIN WHILE */

    while (1)
    {
        /* USER CODE END WHILE */

        /* USER CODE BEGIN 3 */

        /* ====================================================
           VERIFICAR ERRORES DESDE ESP32
           ==================================================== */

        if (errorRecepcion)
        {
            errorRecepcion = 0;

            longitud = 0;
            descartar = 1;

            NeoPixel_Indicar(
                NEO_BRILLO,
                0,
                0
            );

            Sonido_Error();
        }

        /* ====================================================
           VERIFICAR ERRORES DESDE NUCLEO 2
           ==================================================== */

        if (errorUART3)
        {
            errorUART3 = 0;

            UART_Texto(
                &huart2,
                "ADVERTENCIA: Error UART3\r\n"
            );
        }

        /* ====================================================
           PROCESAR COMANDOS DEL ESP32
           ==================================================== */

        if (lectura != escritura)
        {
            uint8_t dato = cola[lectura];

            lectura =
                (lectura + 1U) % TAM_COLA;

            ProcesarCaracter(dato);
        }

        /* ====================================================
           PROCESAR RESPUESTAS DE NUCLEO 2
           ==================================================== */

        ProcesarDatosNucleo2();

        /* ====================================================
           ACTUALIZAR NEOPIXEL Y BUZZER SEGUN SD
           ==================================================== */

        ProcesarEventoSD();

        /* ====================================================
           REGRESAR NEOPIXEL A ESTADO DE ESPERA
           ==================================================== */

        NeoPixel_ActualizarEstado();

        /* USER CODE END 3 */
    }
}

