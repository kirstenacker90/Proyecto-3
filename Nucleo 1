/* ============================================================
   NEOPIXEL - ENVIAR COLOR
   ============================================================ */

static HAL_StatusTypeDef NeoPixel_Color(
    uint8_t rojo,
    uint8_t verde,
    uint8_t azul)
{
    memset(
        neoBuffer,
        0,
        sizeof(neoBuffer)
    );

    uint32_t color =
        ((uint32_t)verde << 16) |
        ((uint32_t)rojo << 8) |
        (uint32_t)azul;

    uint16_t indice = NEO_INICIO;

    for (uint16_t led = 0; led < NEO_CANTIDAD; led++)
    {
        uint32_t colorLED =
            (led < NEO_ACTIVOS) ? color : 0U;

        for (int bit = 23; bit >= 0; bit--)
        {
            neoBuffer[indice++] =
                (colorLED & (1UL << bit))
                ? NEO_UNO
                : NEO_CERO;
        }
    }

    neoTerminado = 0;
    neoError = 0;

    __HAL_TIM_SET_COMPARE(
        &htim1,
        TIM_CHANNEL_1,
        0
    );

    __HAL_TIM_SET_COUNTER(
        &htim1,
        0
    );

    HAL_StatusTypeDef resultado =
        HAL_TIM_PWM_Start_DMA(
            &htim1,
            TIM_CHANNEL_1,
            (uint32_t *)neoBuffer,
            NEO_TAM_BUFFER
        );

    if (resultado != HAL_OK)
    {
        return resultado;
    }

    uint32_t inicio = HAL_GetTick();

    while (!neoTerminado)
    {
        if ((HAL_GetTick() - inicio) >= 20U)
        {
            HAL_TIM_PWM_Stop_DMA(
                &htim1,
                TIM_CHANNEL_1
            );

            __HAL_TIM_SET_COMPARE(
                &htim1,
                TIM_CHANNEL_1,
                0
            );

            return HAL_TIMEOUT;
        }
    }

    HAL_TIM_PWM_Stop_DMA(
        &htim1,
        TIM_CHANNEL_1
    );

    __HAL_TIM_SET_COMPARE(
        &htim1,
        TIM_CHANNEL_1,
        0
    );

    return neoError ? HAL_ERROR : HAL_OK;
}

/* ============================================================
   NEOPIXEL - INDICAR ESTADO TEMPORAL
   ============================================================ */

static void NeoPixel_Indicar(
    uint8_t rojo,
    uint8_t verde,
    uint8_t azul)
{
    if (NeoPixel_Color(
            rojo,
            verde,
            azul) != HAL_OK)
    {
        Error_Handler();
    }

    neoInicioEstado = HAL_GetTick();
    neoRetornoPendiente = 1;
}

/* ============================================================
   NEOPIXEL - INDICAR GUARDADO EN PROCESO
   ============================================================ */

static void NeoPixel_Guardando(void)
{
    neoRetornoPendiente = 0;

    if (NeoPixel_Color(
            NEO_BRILLO,
            0,
            NEO_BRILLO) != HAL_OK)
    {
        Error_Handler();
    }
}

/* ============================================================
   NEOPIXEL - REGRESAR A AZUL
   ============================================================ */

static void NeoPixel_ActualizarEstado(void)
{
    if (guardadoPendiente)
    {
        return;
    }

    if (neoRetornoPendiente &&
        ((HAL_GetTick() - neoInicioEstado) >=
         NEO_DURACION_ESTADO))
    {
        neoRetornoPendiente = 0;

        if (NeoPixel_Color(
                0,
                0,
                NEO_BRILLO) != HAL_OK)
        {
            Error_Handler();
        }
    }
}

/* ============================================================
   PROCESAR COMANDOS RECIBIDOS DEL ESP32
   ============================================================ */

static void ProcesarCaracter(uint8_t dato)
{
    if (dato == '\r' || dato == '\n')
    {
        if (descartar)
        {
            descartar = 0;
            longitud = 0;
            return;
        }

        if (longitud == 0U)
        {
            return;
        }

        texto[longitud] = '\0';

        UART_Texto(
            &huart2,
            "Recibido ESP32: "
        );

        UART_Texto(
            &huart2,
            texto
        );

        UART_Texto(
            &huart2,
            "\r\n"
        );

        /* =====================================
           COMANDO DE PRUEBA
           ===================================== */

        if (strcmp(texto, "PRUEBA") == 0)
        {
            Sonido_Prueba();
            Sonido_Bienvenida();

            HAL_Delay(250);

            Sonido_Enviando();

            HAL_Delay(250);

            Sonido_Error();

            HAL_Delay(250);

            Sonido_Exito();

            longitud = 0;
            return;
        }

        /* =====================================
           PRUEBA DE EXITO
           ===================================== */

        if (strcmp(texto, "EXITO") == 0)
        {
            NeoPixel_Indicar(
                0,
                NEO_BRILLO,
                0
            );

            Sonido_Exito();

            longitud = 0;
            return;
        }

        /* =====================================
           PRUEBA DE ERROR
           ===================================== */

        if (strcmp(texto, "ERROR") == 0)
        {
            NeoPixel_Indicar(
                NEO_BRILLO,
                0,
                0
            );

            Sonido_Error();

            longitud = 0;
            return;
        }

        /* =====================================
           IDENTIFICAR COMANDO
           ===================================== */

        uint8_t esLectura =
            (strcmp(texto, "LECTURA") == 0) ||
            (strcmp(texto, "LEER") == 0) ||
            (strcmp(texto, "L") == 0);

        uint8_t esGuardado =
            (strcmp(texto, "GUARDADO") == 0) ||
            (strcmp(texto, "GUARDAR") == 0) ||
            (strcmp(texto, "G") == 0);

        if (!esLectura && !esGuardado)
        {
            UART_Texto(
                &huart2,
                "Comando no reconocido\r\n"
            );

            UART_Texto(
                &huart1,
                "COMANDO_INVALIDO\r\n"
            );

            NeoPixel_Indicar(
                NEO_BRILLO,
                0,
                0
            );

            Sonido_Error();

            longitud = 0;
            return;
        }

        /* =====================================
           VALIDAR GUARDADO EN PROCESO
           ===================================== */

        if (esGuardado && guardadoPendiente)
        {
            UART_Texto(
                &huart2,
                "Guardado anterior pendiente\r\n"
            );

            UART_Texto(
                &huart1,
                "SD_OCUPADA\r\n"
            );

            longitud = 0;
            return;
        }

        /* =====================================
           INDICADOR SEGUN COMANDO
           ===================================== */

        if (esGuardado)
        {
            /* Morado: almacenamiento */

            NeoPixel_Guardando();

            guardadoPendiente = 1;
        }
        else
        {
            /* Amarillo: lectura */

            NeoPixel_Indicar(
                NEO_BRILLO,
                NEO_BRILLO,
                0
            );
        }

        /* =====================================
           SONIDO DE ENVIO
           ===================================== */

        Sonido_Enviando();

        /* =====================================
           TRANSMITIR COMANDO A NUCLEO 2
           ===================================== */

        HAL_StatusTypeDef resultado =
            HAL_UART_Transmit(
                &huart3,
                (uint8_t *)texto,
                longitud,
                1000
            );

        if (resultado == HAL_OK)
        {
            uint8_t finLinea = '\n';

            resultado = HAL_UART_Transmit(
                &huart3,
                &finLinea,
                1,
                1000
            );
        }

        longitud = 0;

        /* =====================================
           COMPROBAR ENVIO UART
           ===================================== */

        if (resultado == HAL_OK)
        {
            UART_Texto(
                &huart2,
                "UART3 enviado, esperando confirmacion\r\n"
            );

            /*
             * Para LECTURA se conserva
             * la indicacion de transmision.
             *
             * Para GUARDADO se mantiene
             * morado hasta recibir SD_OK
             * o una respuesta de error.
             */

            if (esLectura)
            {
                NeoPixel_Indicar(
                    0,
                    NEO_BRILLO,
                    0
                );
            }
        }
        else
        {
            guardadoPendiente = 0;

            NeoPixel_Indicar(
                NEO_BRILLO,
                0,
                0
            );

            Sonido_Error();

            UART_Texto(
                &huart2,
                "ERROR: No se pudo enviar por UART3\r\n"
            );

            UART_Texto(
                &huart1,
                "ERROR_UART3\r\n"
            );
        }

        return;
    }

    /* =========================================
       PROCESAR CARACTERES DEL COMANDO
       ========================================= */

    if (descartar)
    {
        return;
    }

    if (dato >= 'a' && dato <= 'z')
    {
        dato = (uint8_t)(dato - ('a' - 'A'));
    }

    if (dato >= 32U && dato <= 126U)
    {
        if (longitud < TAM_TEXTO - 1U)
        {
            texto[longitud++] = (char)dato;
        }
        else
        {
            longitud = 0;
            descartar = 1;

            NeoPixel_Indicar(
                NEO_BRILLO,
                0,
                0
            );

            Sonido_Error();
        }
    }
}

/* ============================================================
   PROCESAR LINEAS RECIBIDAS DESDE NUCLEO 2
   ============================================================ */

static void ProcesarLineaNucleo2(const char *linea)
{
    if (strcmp(linea, "SD_OK") == 0)
    {
        guardadoPendiente = 0;
        eventoSD = 1;
    }
    else if (strcmp(linea, "SD_ERROR") == 0)
    {
        guardadoPendiente = 0;
        eventoSD = 2;
    }
    else if (strcmp(linea, "SD_SIN_DATOS") == 0)
    {
        guardadoPendiente = 0;
        eventoSD = 3;
    }
}

/* ============================================================
   RECIBIR Y REENVIAR RESPUESTAS DE NUCLEO 2
   ============================================================ */

static void ProcesarDatosNucleo2(void)
{
    uint8_t datos[64];
    uint16_t cantidad = 0;

    while ((lecturaN2 != escrituraN2) &&
           (cantidad < sizeof(datos)))
    {
        uint8_t dato = colaN2[lecturaN2];

        lecturaN2 =
            (lecturaN2 + 1U) % TAM_COLA_N2;

        datos[cantidad++] = dato;

        /* =====================================
           DETECTAR FINAL DE RESPUESTA
           ===================================== */

        if (dato == '\n')
        {
            respuestaN2[longitudRespuestaN2] = '\0';

            ProcesarLineaNucleo2(respuestaN2);

            longitudRespuestaN2 = 0;
        }
        else if (dato != '\r')
        {
            if (longitudRespuestaN2 <
                TAM_RESPUESTA_N2 - 1U)
            {
                respuestaN2[longitudRespuestaN2++] =
                    (char)dato;
            }
            else
            {
                longitudRespuestaN2 = 0;
            }
        }
    }

    if (cantidad > 0U)
    {
        /* =====================================
           ENVIAR DATOS A HERCULES
           ===================================== */

        HAL_UART_Transmit(
            &huart2,
            datos,
            cantidad,
            1000
        );

        /* =====================================
           ENVIAR DATOS AL ESP32
           ===================================== */

        HAL_UART_Transmit(
            &huart1,
            datos,
            cantidad,
            1000
        );
    }
}

/* ============================================================
   PROCESAR RESULTADOS DE GUARDADO
   ============================================================ */

static void ProcesarEventoSD(void)
{
    uint8_t evento = eventoSD;

    if (evento == 0U)
    {
        return;
    }

    eventoSD = 0;

    /* =====================================
       GUARDADO EXITOSO
       ===================================== */

    if (evento == 1U)
    {
        UART_Texto(
            &huart2,
            "Confirmacion: archivo SD guardado\r\n"
        );

        NeoPixel_Indicar(
            0,
            NEO_BRILLO,
            0
        );

        Sonido_Exito();
    }

    /* =====================================
       ERROR DE TARJETA SD
       ===================================== */

    else if (evento == 2U)
    {
        UART_Texto(
            &huart2,
            "Error: almacenamiento microSD\r\n"
        );

        NeoPixel_Indicar(
            NEO_BRILLO,
            0,
            0
        );

        Sonido_Error();
    }

    /* =====================================
       SIN MEDICIONES VALIDAS
       ===================================== */

    else if (evento == 3U)
    {
        UART_Texto(
            &huart2,
            "Error: primero realiza una lectura\r\n"
        );

        NeoPixel_Indicar(
            NEO_BRILLO,
            0,
            0
        );

        Sonido_Error();
    }
}

